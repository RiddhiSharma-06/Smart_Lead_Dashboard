{
  "compilerOptions": {
   
    "types": ["node"],
    "target": "ES6",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "typeRoots": ["./src/@types", "./node_modules/@types"]
     
  },
  "include": ["src"]
}